  "main": "index.js",
  "scripts": {
    "dev": "node bin/www.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "typeorm migration:run -d db/data-source.js",
