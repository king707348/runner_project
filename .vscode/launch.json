{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug 目前開啟的檔案",
      "type": "node",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "env": { "NODE_ENV": "development", "LOG_LEVEL": "debug" },
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Debug 伺服器 (bin/www.js)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/bin/www.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
