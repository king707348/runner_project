# 伺服器設定
PORT=3006
CORS_ORIGIN=*

# PostgreSQL 資料庫連線設定 (Docker 本地開發)
# 注意：若有設定 DATABASE_URL，系統將優先採用 DATABASE_URL，個別 DB_* 設定將被忽略。
DATABASE_URL=postgresql://pacer_user:pacer_secret@localhost:5432/pacer_db

# 個別連線參數（若未設定 DATABASE_URL 時使用）
DB_HOST=localhost
DB_PORT=5432
DB_USER=pacer_user
DB_PASSWORD=pacer_secret
DB_NAME=pacer_db
